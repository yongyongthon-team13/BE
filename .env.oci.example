# Copy to .env.oci on the OCI VM. Never commit the copy.
DB_NAME=gilbut
DB_USERNAME=gilbut_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Generate each key with: openssl rand -base64 32
APP_DATA_KEY=replace-with-base64-32-byte-key
APP_JWT_SECRET=replace-with-a-different-base64-32-byte-key

# Add provider credentials only when the corresponding feature is needed.
TMAP_APP_KEY=
TMAP_TRANSIT_APP_KEY=
GBIS_SERVICE_KEY=
GEMINI_API_KEY=
SMS_PROVIDER=none
NCLOUD_SMS_SERVICE_ID=
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=
NCLOUD_SMS_SENDER=
